# systemd unit: copy to /etc/systemd/system/sidescript.service, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now sidescript
[Unit]
Description=Sidescript document editor
After=network.target

[Service]
Type=simple
User=sidescript
WorkingDirectory=/opt/sidescript
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/var/lib/sidescript
Environment=COOKIE_SECURE=1
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
# Give the server time to flush open documents to disk on stop.
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening: the app can only write to its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sidescript

[Install]
WantedBy=multi-user.target
